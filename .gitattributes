# Normalize line endings: the plugin runs on Linux and release zips must ship LF.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.mo   binary
*.zip  binary

# Keep repository-only files out of `git archive` release zips.
.gitattributes export-ignore
.gitignore     export-ignore
.github        export-ignore
docs           export-ignore
