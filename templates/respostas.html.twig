<div class="card">
   {% if linhas is empty %}
      <div class="card-body text-muted">{{ __('O cliente ainda não respondeu pelo link.', 'propostas') }}</div>
   {% else %}
      <div class="table-responsive">
         <table class="table table-hover card-table">
            <thead>
               <tr>
                  <th>{{ __('Data') }}</th>
                  <th>{{ __('Tipo', 'propostas') }}</th>
                  <th>{{ __('Versão', 'propostas') }}</th>
                  <th>{{ __('Nome', 'propostas') }}</th>
                  <th>{{ __('CPF', 'propostas') }}</th>
                  <th>{{ __('Detalhe', 'propostas') }}</th>
                  <th>{{ __('Origem', 'propostas') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for l in linhas %}
                  <tr>
                     <td class="text-nowrap">{{ l.data|formatted_datetime }}</td>
                     <td>
                        <span class="badge {{ l.aceite ? 'bg-green-lt' : 'bg-orange-lt' }}">{{ l.tipo }}</span>
                     </td>
                     <td>{{ l.versao }}</td>
                     <td>{{ l.nome }}</td>
                     <td class="text-nowrap">{{ l.cpf }}</td>
                     <td>
                        {% if l.aceite %}
                           <div><strong>{{ __('Código', 'propostas') }}:</strong> <code>{{ l.codigo }}</code></div>
                           <div class="small text-muted text-break" title="{{ __('SHA-256 dos valores aceitos', 'propostas') }}">{{ l.hash }}</div>
                           {% if l.versao == versao_atual %}
                              {% if l.hash == hash_atual %}
                                 <div class="small text-success"><i class="ti ti-check"></i> {{ __('Confere com os valores atuais da proposta.', 'propostas') }}</div>
                              {% else %}
                                 <div class="small text-danger"><i class="ti ti-alert-triangle"></i> {{ __('Não confere com os valores atuais da proposta.', 'propostas') }}</div>
                              {% endif %}
                           {% endif %}
                        {% else %}
                           <div style="white-space: pre-wrap;">{{ l.mensagem }}</div>
                        {% endif %}
                     </td>
                     <td class="small text-muted">
                        {{ l.ip }}
                        <div class="text-truncate" style="max-width: 220px;" title="{{ l.agente }}">{{ l.agente }}</div>
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
</div>
