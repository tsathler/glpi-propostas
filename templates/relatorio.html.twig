{% macro tabela(titulo, coluna, linhas) %}
<div class="card mb-3">
   <div class="card-header"><h3 class="card-title">{{ titulo }}</h3></div>
   {% if linhas is empty %}
      <div class="card-body text-muted">{{ __('Nenhuma proposta enviada ou aceita no período.', 'propostas') }}</div>
   {% else %}
      <div class="table-responsive">
         <table class="table table-hover card-table">
            <thead>
               <tr>
                  <th rowspan="2" class="align-bottom">{{ coluna }}</th>
                  <th colspan="4" class="text-center border-start">{{ __('Conversão (enviadas no período)', 'propostas') }}</th>
                  <th colspan="3" class="text-center border-start">{{ __('Fechamento (aceitas no período)', 'propostas') }}</th>
               </tr>
               <tr>
                  <th class="text-end border-start">{{ __('Enviadas', 'propostas') }}</th>
                  <th class="text-end">{{ __('Aceitas', 'propostas') }}</th>
                  <th class="text-end">{{ __('Em aberto', 'propostas') }}</th>
                  <th class="text-end" title="{{ __('Aceitas ÷ enviadas no período', 'propostas') }}">{{ __('Taxa', 'propostas') }}</th>
                  <th class="text-end border-start">{{ __('Aceitas', 'propostas') }}</th>
                  <th class="text-end">{{ __('R$ mensal', 'propostas') }}</th>
                  <th class="text-end">{{ __('R$ pontual', 'propostas') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for l in linhas %}
                  <tr>
                     <td>{{ l.nome }}</td>
                     <td class="text-end border-start">{{ l.enviadas }}</td>
                     <td class="text-end">{{ l.aceitas_envio }}</td>
                     <td class="text-end">{{ l.em_aberto }}</td>
                     <td class="text-end">{% if l.taxa is null %}<span class="text-muted">—</span>{% else %}{{ (l.taxa * 100)|number_format(0, ',', '.') }}%{% endif %}</td>
                     <td class="text-end border-start">{{ l.aceitas }}</td>
                     <td class="text-end text-nowrap">{{ l.recorrente|number_format(2, ',', '.') }}</td>
                     <td class="text-end text-nowrap">
                        {{ l.pontual|number_format(2, ',', '.') }}
                        {% if l.por_unidade > 0 %}
                           <div class="small text-muted" title="{{ __('Propostas com preço por unidade não têm total a somar.', 'propostas') }}">
                              {{ __('+%d por unidade, sem total', 'propostas')|format(l.por_unidade) }}
                           </div>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
</div>
{% endmacro %}

<form method="get" action="{{ url }}" class="card mb-3">
   <div class="card-body d-flex flex-wrap gap-3 align-items-end">
      <label>{{ __('Início', 'propostas') }}
         <input type="date" name="inicio" value="{{ inicio }}" class="form-control" required>
      </label>
      <label>{{ __('Fim', 'propostas') }}
         <input type="date" name="fim" value="{{ fim }}" class="form-control" required>
      </label>
      {% if mostrar_equipes %}
         <label>{{ __('Equipe', 'propostas') }}
            <select name="equipe" class="form-select">
               <option value="0">{{ __('Todas', 'propostas') }}</option>
               {% for e in opcoes_equipe %}
                  <option value="{{ e.id }}" {{ e.id == equipe ? 'selected' : '' }}>{{ e.nome }}</option>
               {% endfor %}
            </select>
         </label>
      {% endif %}
      <button type="submit" class="btn btn-primary">{{ __('Filtrar', 'propostas') }}</button>
      <a class="btn btn-outline-secondary" href="{{ url }}?{{ {'inicio': inicio, 'fim': fim, 'equipe': equipe, 'csv': 1}|url_encode }}">
         <i class="ti ti-download"></i> {{ __('Exportar CSV', 'propostas') }}
      </a>
   </div>
</form>

{{ _self.tabela(__('Por consultor', 'propostas'), __('Consultor', 'propostas'), consultores) }}
{% if mostrar_equipes %}
   {{ _self.tabela(__('Por equipe', 'propostas'), __('Equipe', 'propostas'), equipes) }}
{% endif %}
