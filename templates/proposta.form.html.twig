{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set travado = {disabled: not editavel} %}

{% block more_fields %}
   {% if not item.isNewItem() %}
      {{ fields.htmlField('', numero|e ~ ' · ' ~ __('versão', 'propostas') ~ ' ' ~ item.fields['versao'], __('Número', 'propostas')) }}
      {{ fields.htmlField('', '<span class="badge bg-blue-lt">' ~ status_label|e ~ '</span>', __('Status')) }}
   {% endif %}

   {# Modelo: escolhido só na criação; depois fica só a informação de origem. #}
   {% if item.isNewItem() %}
      {{ fields.dropdownField('GlpiPlugin\\Propostas\\Modelo', 'plugin_propostas_modelos_id', 0, __('Modelo de proposta', 'propostas'), {
         condition: {'is_active': 1},
         entity: item.fields['entities_id'],
         helper: __('Validade, condições, itens e blocos de texto do modelo são copiados para a proposta. O modelo não pode ser trocado depois.', 'propostas')
      }) }}

      {# Ao escolher o modelo: valor e desconto (%) de cada item (editáveis) e o valor final.
         Campo de largura total do GLPI: o rótulo fica na coluna dos rótulos e a tabela na dos campos. #}
      {% set quadro_valores %}
         <table class="propostas-valores">
            <thead>
               <tr>
                  <th scope="col">{{ __('Item', 'propostas') }}</th>
                  <th scope="col" class="col-valor">{{ __('Valor', 'propostas') }}</th>
                  <th scope="col" class="col-desconto">{{ __('Desconto', 'propostas') }}</th>
                  <th scope="col" class="col-final">{{ __('Valor final', 'propostas') }}</th>
               </tr>
            </thead>
            <tbody id="propostas-modelo-itens"></tbody>
            <tfoot>
               <tr>
                  <td colspan="3">
                     <span class="propostas-dica" id="propostas-desconto-dica"></span>
                     <button type="button" class="btn btn-sm btn-outline-secondary ms-2 d-none" id="propostas-usar-sugerido"></button>
                  </td>
                  <td class="col-final" id="propostas-economia" data-rotulo="{{ __('Diferença:', 'propostas') }}"></td>
               </tr>
            </tfoot>
         </table>
         <div class="form-text" id="propostas-modelo-dica">{{ __('Os valores e descontos vêm do modelo. Ajuste item a item se precisar.', 'propostas') }}</div>
         <div class="form-text text-danger" id="propostas-modelo-msg"></div>
      {% endset %}
      {{ fields.htmlField('', quadro_valores, __('Valores', 'propostas'), {
         full_width: true,
         wrapper_class: 'w-100',
         add_field_class: 'd-none',
         add_label_class: 'align-self-start propostas-rotulo-valores',
         add_field_attribs: {id: 'propostas-modelo-campos', 'aria-live': 'polite'}
      }) }}
      <style>
         /* Mesmas medidas dos campos do formulário: 40 px de altura, 14 px, cantos de 10 px; linhas de 48 px. */
         .propostas-valores { width: 100%; border-collapse: collapse; font-size: 14px; }
         /* Rótulo ao lado (telas largas): na altura do primeiro item, não do cabeçalho da tabela. */
         @media (min-width: 1400px) { .propostas-rotulo-valores { margin-top: 28px; } }
         .propostas-valores th { font-size: 12px; font-weight: 600; color: var(--tblr-secondary, #667382);
            text-align: left; padding: 0 0 6px; border-bottom: 1px solid var(--tblr-border-color, #dce1e7); background: none; }
         .propostas-valores td { height: 48px; padding: 4px 0; vertical-align: middle;
            border-bottom: 1px solid var(--tblr-border-color-translucent, rgba(4, 32, 69, .1)); }
         .propostas-valores tfoot td { border-bottom: 0; padding-top: 8px; }
         .propostas-valores .col-valor { width: 180px; padding-left: 16px; }
         .propostas-valores .col-desconto { width: 130px; padding-left: 12px; }
         .propostas-valores .col-final { width: 140px; padding-left: 16px; text-align: right; font-weight: 600; white-space: nowrap; }
         .propostas-valores th.col-final { text-align: right; }
         .propostas-valores .badge { margin-left: 8px; vertical-align: middle; }
         .propostas-valores .propostas-dica { font-size: 12px; color: var(--tblr-secondary, #667382); }
         @media (max-width: 767.98px) {
            .propostas-valores thead { display: none; }
            /* Nome em cima; valor e desconto lado a lado; valor final embaixo, com rótulo. */
            .propostas-valores tr { display: grid; grid-template-columns: minmax(0, 1fr) 120px; gap: 6px; padding: 10px 0;
               border-bottom: 1px solid var(--tblr-border-color-translucent, rgba(4, 32, 69, .1)); }
            .propostas-valores tfoot tr { border-bottom: 0; }
            .propostas-valores td { height: auto; border: 0; padding: 0; }
            .propostas-valores td:first-child, .propostas-valores .col-final, .propostas-valores tfoot td { grid-column: 1 / -1; }
            .propostas-valores .col-valor, .propostas-valores .col-desconto { width: auto; padding-left: 0; }
            .propostas-valores .col-final { width: auto; padding-left: 0; text-align: left; }
            .propostas-valores .col-final:not(:empty)::before { content: attr(data-rotulo) " "; font-weight: 400;
               color: var(--tblr-secondary, #667382); }
         }
      </style>
      <script>
         (function () {
            const url = {{ modelo_url|json_encode|raw }};
            const caixa = document.getElementById('propostas-modelo-campos');
            const lista = document.getElementById('propostas-modelo-itens');
            const dica = document.getElementById('propostas-desconto-dica');
            const usar = document.getElementById('propostas-usar-sugerido');
            const economia = document.getElementById('propostas-economia');
            const msg = document.getElementById('propostas-modelo-msg');
            const moeda = new Intl.NumberFormat('pt-BR', {style: 'currency', currency: 'BRL'});
            const textos = {
               mensal: {{ __('Mensal', 'propostas')|json_encode|raw }},
               unico: {{ __('Pagamento único', 'propostas')|json_encode|raw }},
               sugerido: {{ __('Desconto sugerido pelo modelo: {pct}%', 'propostas')|json_encode|raw }},
               usar: {{ __('Usar {pct}% em todos', 'propostas')|json_encode|raw }},
               final: {{ __('Valor final:', 'propostas')|json_encode|raw }},
               desconto: {{ __('Desconto (%) de', 'propostas')|json_encode|raw }},
               vazio: {{ __('Este modelo não tem itens com valor.', 'propostas')|json_encode|raw }},
               erro: {{ __('Não foi possível carregar os itens do modelo.', 'propostas')|json_encode|raw }}
            };
            let sugerido = 0;

            // Mesmo arredondamento do servidor (round do PHP 8.4, Calculo::subtotal): pela forma decimal
            // mais curta do número, metade para cima. Ex.: 1,15 × 50% = 0,575 → 0,58; 8,45 × 90% → 7,60.
            function arredondar2(x) {
               const texto = Math.abs(x).toString();
               if (texto.includes('e')) { return Math.round(x * 100) / 100; }
               const partes = texto.split('.');
               const decimais = (partes[1] || '') + '000';
               let centavos = Number(partes[0]) * 100 + Number(decimais.slice(0, 2));
               if (Number(decimais[2]) >= 5) { centavos += 1; }
               return (x < 0 ? -centavos : centavos) / 100;
            }

            function numero(campo) {
               const v = parseFloat(campo.value);
               return v > 0 ? v : 0;
            }

            // Valor final de cada item com o seu desconto, como o cliente vai ver, e a diferença total.
            function atualizar() {
               let diferenca = 0;
               lista.querySelectorAll('tr').forEach(function (tr) {
                  const valor = numero(tr.querySelector('.propostas-campo-valor'));
                  const p = Math.min(numero(tr.querySelector('.propostas-campo-desconto')), 100);
                  const final = arredondar2(valor * (1 - p / 100));
                  diferenca += (valor - final) * (Number(tr.dataset.quantidade) || 1);
                  const celula = tr.querySelector('.col-final');
                  celula.textContent = moeda.format(final);
                  celula.classList.toggle('text-success', p > 0);
                  celula.classList.toggle('text-secondary', p === 0);
               });
               diferenca = Math.round(diferenca * 100) / 100;
               economia.textContent = diferenca > 0 ? '−' + moeda.format(diferenca) : '';
               economia.className = 'col-final' + (diferenca > 0 ? ' text-success' : '');
            }

            function limpar() {
               lista.replaceChildren();
               sugerido = 0;
               dica.textContent = '';
               usar.classList.add('d-none');
               msg.textContent = '';
               atualizar();
            }

            function campoNumero(classe, nome, valor, rotulo, prefixo, sufixo) {
               const grupo = document.createElement('div');
               grupo.className = 'input-group';
               const campo = document.createElement('input');
               campo.type = 'number';
               // "any": o preço do modelo pode ter até 4 casas (0,0125).
               campo.step = 'any';
               campo.min = '0';
               if (sufixo === '%') { campo.max = '100'; }
               campo.className = 'form-control text-end ' + classe;
               campo.name = nome;
               campo.value = valor;
               campo.setAttribute('aria-label', rotulo);
               campo.addEventListener('input', atualizar);
               if (prefixo) {
                  const antes = document.createElement('span');
                  antes.className = 'input-group-text';
                  antes.textContent = prefixo;
                  grupo.append(antes);
               }
               grupo.append(campo);
               if (sufixo) {
                  const depois = document.createElement('span');
                  depois.className = 'input-group-text';
                  depois.textContent = sufixo;
                  grupo.append(depois);
               }
               return grupo;
            }

            function linha(item) {
               const tr = document.createElement('tr');
               tr.dataset.quantidade = String(item.quantidade);

               const nome = document.createElement('td');
               const rotulo = document.createElement('span');
               rotulo.textContent = item.nome;
               const tipo = document.createElement('span');
               tipo.className = 'badge ' + (item.tipo === 'pontual' ? 'bg-secondary-lt' : 'bg-blue-lt');
               tipo.textContent = item.tipo === 'pontual' ? textos.unico : textos.mensal;
               nome.append(rotulo, tipo);

               const valor = document.createElement('td');
               valor.className = 'col-valor';
               valor.append(campoNumero('propostas-campo-valor', '_modelo_valores[' + item.id + ']',
                  String(Number(item.valor)), item.nome, 'R$', ''));

               const desconto = document.createElement('td');
               desconto.className = 'col-desconto';
               desconto.append(campoNumero('propostas-campo-desconto', '_modelo_descontos[' + item.id + ']',
                  String(Number(item.desconto) || 0), textos.desconto + ' ' + item.nome, '', '%'));

               const final = document.createElement('td');
               final.className = 'col-final';
               final.dataset.rotulo = textos.final;

               tr.append(nome, valor, desconto, final);
               return tr;
            }

            let pedido = 0;

            async function carregar(id) {
               const meu = ++pedido;
               limpar();
               if (!id || id === '0') { caixa.classList.add('d-none'); return; }
               caixa.classList.remove('d-none');
               try {
                  const resposta = await fetch(url + '?id=' + encodeURIComponent(id), {credentials: 'same-origin'});
                  const dados = await resposta.json();
                  // Modelo trocado de novo enquanto esperava: a resposta antiga é descartada.
                  if (meu !== pedido) { return; }
                  if (!dados.ok) { msg.textContent = dados.erro || textos.erro; return; }
                  dados.itens.forEach(function (item) { lista.append(linha(item)); });
                  if (dados.itens.length === 0) { msg.textContent = textos.vazio; }
                  // O desconto sugerido só preenche os campos quando o consultor pede.
                  sugerido = Number(dados.desconto_especial) || 0;
                  if (sugerido > 0 && dados.itens.length > 0) {
                     const pct = String(sugerido).replace('.', ',');
                     dica.textContent = textos.sugerido.replace('{pct}', pct);
                     usar.textContent = textos.usar.replace('{pct}', pct);
                     usar.classList.remove('d-none');
                  }
                  atualizar();
               } catch (e) {
                  msg.textContent = textos.erro;
               }
            }

            usar.addEventListener('click', function () {
               lista.querySelectorAll('.propostas-campo-desconto').forEach(function (campo) { campo.value = sugerido; });
               atualizar();
            });

            // O campo do modelo é um select2: a troca chega como evento "change" do jQuery.
            $(document).on('change', 'select[name="plugin_propostas_modelos_id"]', function () {
               carregar(this.value);
            });
         })();
      </script>
   {% elseif modelo %}
      {{ fields.htmlField('', '<a href="' ~ modelo.getLinkURL() ~ '">' ~ modelo.fields['name']|e ~ '</a>', __('Modelo de origem', 'propostas')) }}
   {% endif %}

   {# Empresa cliente: obrigatória (razão social e CNPJ) só para gerar o link. #}
   <div class="col-12 mt-2"><h4 class="mb-0"><i class="ti ti-building"></i> {{ __('Empresa cliente', 'propostas') }}</h4></div>

   {% set campo_cnpj %}
      <div class="input-group">
         <input type="text" class="form-control" name="empresa_cnpj" id="propostas-cnpj" maxlength="18"
                value="{{ item.fields['empresa_cnpj'] }}" placeholder="00.000.000/0000-00" {{ editavel ? '' : 'disabled' }}>
         {% if cnpj_consulta and editavel %}
            <button type="button" class="btn btn-outline-secondary" id="propostas-buscar-cnpj">
               <i class="ti ti-search"></i> {{ __('Buscar CNPJ', 'propostas') }}
            </button>
         {% endif %}
      </div>
      <div class="form-text" id="propostas-cnpj-msg"></div>
   {% endset %}
   {{ fields.htmlField('', campo_cnpj, __('CNPJ', 'propostas')) }}

   {{ fields.textField('empresa_razao_social', item.fields['empresa_razao_social'], __('Razão social', 'propostas'), travado|merge({id: 'propostas-razao'})) }}
   {{ fields.textField('empresa_nome_fantasia', item.fields['empresa_nome_fantasia'], __('Nome fantasia', 'propostas'), travado|merge({id: 'propostas-fantasia'})) }}
   {{ fields.textField('solicitante', item.fields['solicitante'], __('Contato na empresa', 'propostas'), travado) }}

   {% if cnpj_consulta and editavel %}
      <script>
         (function () {
            const botao = document.getElementById('propostas-buscar-cnpj');
            if (!botao) { return; }
            botao.addEventListener('click', async function () {
               const msg = document.getElementById('propostas-cnpj-msg');
               const cnpj = document.getElementById('propostas-cnpj').value;
               msg.className = 'form-text';
               msg.textContent = '{{ __('Consultando…', 'propostas')|e('js') }}';
               botao.disabled = true;
               try {
                  const r = await fetch('{{ cnpj_url }}?' + new URLSearchParams({cnpj: cnpj}), {
                     headers: {'X-Requested-With': 'XMLHttpRequest'}
                  });
                  const d = await r.json();
                  if (!d.ok) {
                     msg.className = 'form-text text-danger';
                     msg.textContent = d.erro;
                     return;
                  }
                  document.getElementById('propostas-cnpj').value = d.cnpj;
                  if (d.razao_social) { document.querySelector('[name=empresa_razao_social]').value = d.razao_social; }
                  if (d.nome_fantasia) { document.querySelector('[name=empresa_nome_fantasia]').value = d.nome_fantasia; }
                  msg.className = d.ativa ? 'form-text text-success' : 'form-text text-warning';
                  msg.textContent = d.ativa
                     ? '{{ __('Dados preenchidos. Confira e salve.', 'propostas')|e('js') }}'
                     : '{{ __('Atenção: situação cadastral', 'propostas')|e('js') }} ' + (d.situacao || '?') + '. {{ __('Confira e salve.', 'propostas')|e('js') }}';
               } catch (e) {
                  msg.className = 'form-text text-danger';
                  msg.textContent = '{{ __('Não foi possível consultar agora. Digite os dados à mão.', 'propostas')|e('js') }}';
               } finally {
                  botao.disabled = false;
               }
            });
         })();
      </script>
   {% endif %}

   <div class="col-12 mt-2"><h4 class="mb-0"><i class="ti ti-file-dollar"></i> {{ __('Proposta', 'propostas') }}</h4></div>

   {% if consultor_fixo %}
      {# Só "Ler as próprias": não há outro consultor possível; mostra o nome, sem menu. #}
      {{ fields.htmlField('', '<i class="ti ti-lock text-secondary"></i> ' ~ consultor_nome|e, __('Consultor', 'propostas'), {
         helper: __('Você é o consultor das suas propostas.', 'propostas')
      }) }}
      <input type="hidden" name="users_id_consultor" value="{{ consultor_id }}">
   {% elseif consultores is null %}
      {{ fields.dropdownField('User', 'users_id_consultor', item.fields['users_id_consultor'], __('Consultor', 'propostas'), travado|merge({
         right: 'all',
         entity: item.fields['entities_id']
      })) }}
   {% else %}
      {# Equipes ligadas: só quem este usuário pode pôr como consultor (em branco = ele mesmo, ao criar). #}
      {{ fields.dropdownArrayField('users_id_consultor', item.fields['users_id_consultor'], consultores, __('Consultor', 'propostas'), travado|merge({
         display_emptychoice: true,
         helper: __('Só aparecem os consultores que você pode escolher, pelas equipes.', 'propostas')
      })) }}
   {% endif %}

   {# Na criação não há chamado: o plugin abre um ao gerar o link. Depois, dá para vincular um existente. #}
   {% if item.isNewItem() %}
      {{ fields.htmlField('', '<span class="text-secondary"><i class="ti ti-lock"></i> ' ~ __('Aberto automaticamente ao gerar o link', 'propostas')|e ~ '</span>', __('Chamado vinculado', 'propostas')) }}
   {% else %}
      {{ fields.dropdownField('Ticket', 'tickets_id', item.fields['tickets_id'], __('Chamado vinculado', 'propostas'), travado|merge({
         entity: item.fields['entities_id'],
         helper: __('Em branco, o plugin abre um chamado ao gerar o link.', 'propostas')
      })) }}
   {% endif %}

   {{ fields.dateField('data_emissao', item.fields['data_emissao'], __('Emissão', 'propostas'), travado) }}

   {{ fields.numberField('validade_dias', item.fields['validade_dias'], __('Validade (dias)', 'propostas'), travado|merge({min: 1})) }}

   {# Na criação, vem do modelo. Depois, pode ser ajustada enquanto a proposta é rascunho. #}
   {% if not item.isNewItem() %}
      {{ fields.dropdownArrayField('exibicao', item.fields['exibicao'] ?? 'total', exibicoes, __('Valores na página do cliente', 'propostas'), travado) }}
   {% endif %}

   {% if totais %}
      {{ fields.htmlField('', 'R$ ' ~ totais['recorrente'] ~ ' / ' ~ __('mês', 'propostas'), __('Investimento mensal', 'propostas')) }}
      {{ fields.htmlField('', 'R$ ' ~ totais['pontual'], __('Implantação (pagamento único)', 'propostas')) }}
   {% endif %}

   {# Sem o campo na configuração, o texto do modelo (se houver) aparece só para leitura. #}
   {% if editavel and pede_condicoes %}
      {{ fields.textareaField('condicoes', item.fields['condicoes'], __('Condições comerciais', 'propostas'), {
         enable_richtext: true,
         full_width: true
      }) }}
   {% elseif item.fields['condicoes'] is not empty %}
      {# Travada: mostra o texto formatado em vez do HTML cru num campo desabilitado. #}
      {{ fields.htmlField('', item.fields['condicoes']|safe_html, __('Condições comerciais', 'propostas'), {
         full_width: true
      }) }}
   {% endif %}

   {# Anotação interna (não aparece para o cliente); pode mudar mesmo com a proposta enviada. #}
   {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', get_plural_number()), {
      full_width: true,
      rows: 3,
      helper: __('Anotação interna da equipe comercial. O cliente não vê.', 'propostas')
   }) }}

   {% if not item.isNewItem() %}
      <div class="col-12 mt-3">
         <div class="card bg-light-lt">
            <div class="card-body">
               <h4 class="card-title mb-2">
                  <i class="ti ti-link"></i> {{ __('Link para o cliente', 'propostas') }}
               </h4>

               {% if link_publico %}
                  <div class="input-group mb-2">
                     <input type="text" class="form-control" id="propostas-link" value="{{ link_publico }}" readonly>
                     <button type="button" class="btn btn-outline-secondary" id="propostas-copiar">
                        <i class="ti ti-copy"></i> {{ __('Copiar', 'propostas') }}
                     </button>
                     <a class="btn btn-outline-secondary" href="{{ link_publico }}" target="_blank" rel="noopener">
                        <i class="ti ti-external-link"></i> {{ __('Abrir', 'propostas') }}
                     </a>
                  </div>
                  <div class="text-muted small mb-2">
                     {% if link_expirado %}
                        <span class="text-danger">{{ __('Link expirado em', 'propostas') }} {{ link_expira|formatted_datetime }}.</span>
                     {% else %}
                        {{ __('Válido até', 'propostas') }} {{ link_expira|formatted_datetime }}.
                     {% endif %}
                     {{ __('Abrir o link estando logado no GLPI não conta como visualização do cliente.', 'propostas') }}
                  </div>
               {% elseif link_oculto %}
                  <p class="text-muted mb-2">
                     {{ __('Link enviado ao cliente. O endereço aparece só para quem pode editar a proposta.', 'propostas') }}
                     {% if link_expirado %}
                        <span class="text-danger">{{ __('Link expirado em', 'propostas') }} {{ link_expira|formatted_datetime }}.</span>
                     {% else %}
                        {{ __('Válido até', 'propostas') }} {{ link_expira|formatted_datetime }}.
                     {% endif %}
                  </p>
               {% elseif editavel %}
                  <p class="text-muted mb-2">
                     {{ __('Ao gerar o link, a proposta é travada para edição e passa para "Enviada".', 'propostas') }}
                  </p>
               {% endif %}

               <div class="d-flex flex-wrap gap-2">
                  {% if pode_gerar %}
                     <button type="submit" name="gerar_link" value="1" class="btn btn-primary">
                        <i class="ti ti-send"></i> {{ __('Gerar link', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_reabrir %}
                     <button type="submit" name="reabrir" value="1" class="btn btn-outline-warning"
                             onclick="return confirm('{{ __('Reabrir cria uma nova versão e invalida o link atual. Continuar?', 'propostas')|e('js') }}');">
                        <i class="ti ti-lock-open"></i> {{ __('Reabrir para edição', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_duplicar %}
                     <button type="submit" name="duplicar" value="1" class="btn btn-outline-secondary">
                        <i class="ti ti-copy"></i> {{ __('Duplicar', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_cancelar %}
                     <button type="submit" name="cancelar" value="1" class="btn btn-outline-danger"
                             onclick="return confirm('{{ __('Cancelar a proposta e invalidar o link?', 'propostas')|e('js') }}');">
                        <i class="ti ti-ban"></i> {{ __('Cancelar proposta', 'propostas') }}
                     </button>
                  {% endif %}
               </div>
            </div>
         </div>
      </div>

      {% if link_publico %}
         <script>
            document.getElementById('propostas-copiar')?.addEventListener('click', function () {
               const campo = document.getElementById('propostas-link');
               campo.select();
               navigator.clipboard?.writeText(campo.value);
               this.innerHTML = '<i class="ti ti-check"></i> {{ __('Copiado', 'propostas')|e('js') }}';
            });
         </script>
      {% endif %}
   {% endif %}
{% endblock %}
