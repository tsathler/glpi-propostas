{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set travado = {disabled: not editavel} %}

{% block more_fields %}
   {% if not item.isNewItem() %}
      {{ fields.htmlField('', numero|e ~ ' · ' ~ __('versão', 'propostas') ~ ' ' ~ item.fields['versao'], __('Número', 'propostas')) }}
      {{ fields.htmlField('', '<span class="badge bg-blue-lt">' ~ status_label|e ~ '</span>', __('Status')) }}
   {% endif %}

   {# Modelo: escolhido só na criação; depois fica só a informação de origem. #}
   {% if item.isNewItem() %}
      {{ fields.dropdownField('GlpiPlugin\\Propostas\\Modelo', 'plugin_propostas_modelos_id', 0, __('Modelo de proposta', 'propostas'), {
         condition: {'is_active': 1},
         entity: item.fields['entities_id'],
         helper: __('Validade, condições, itens e blocos de texto do modelo são copiados para a proposta. O modelo não pode ser trocado depois.', 'propostas')
      }) }}

      {# Ao escolher o modelo: o valor de cada item (editável), o desconto (%) e a prévia do valor final. #}
      <div class="col-12 mb-3 d-none" id="propostas-modelo-campos" aria-live="polite">
         <div class="card">
            <div class="card-header py-2">
               <h4 class="card-title mb-0"><i class="ti ti-receipt"></i> {{ __('Valores desta proposta', 'propostas') }}</h4>
               <span class="text-muted small ms-auto">{{ __('Vêm do modelo. Ajuste se precisar.', 'propostas') }}</span>
            </div>
            <div class="table-responsive">
               <table class="table table-vcenter card-table mb-0">
                  <thead>
                     <tr>
                        <th>{{ __('Item', 'propostas') }}</th>
                        <th class="text-end" style="width: 190px;">{{ __('Valor', 'propostas') }}</th>
                        <th class="text-end" style="width: 150px;">{{ __('Valor final', 'propostas') }}</th>
                     </tr>
                  </thead>
                  <tbody id="propostas-modelo-itens"></tbody>
               </table>
            </div>
            <div class="card-footer py-2 d-flex flex-wrap align-items-center gap-3">
               <label class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" name="_aplicar_desconto" value="1" id="propostas-aplicar-desconto">
                  <span class="form-check-label">{{ __('Aplicar desconto a todos os itens', 'propostas') }}</span>
               </label>
               <div class="input-group input-group-sm" style="width: 110px;">
                  <input type="number" class="form-control text-end" name="_desconto_pct" id="propostas-desconto-pct"
                         min="0" max="100" step="0.01" aria-label="{{ __('Desconto (%)', 'propostas') }}" disabled>
                  <span class="input-group-text">%</span>
               </div>
               <span class="text-muted small" id="propostas-desconto-dica"></span>
            </div>
            <div class="form-text px-3 pb-2 text-danger" id="propostas-modelo-msg"></div>
         </div>
      </div>
      <script>
         (function () {
            const url = {{ modelo_url|json_encode|raw }};
            const caixa = document.getElementById('propostas-modelo-campos');
            const lista = document.getElementById('propostas-modelo-itens');
            const aplicar = document.getElementById('propostas-aplicar-desconto');
            const pct = document.getElementById('propostas-desconto-pct');
            const dica = document.getElementById('propostas-desconto-dica');
            const msg = document.getElementById('propostas-modelo-msg');
            const moeda = new Intl.NumberFormat('pt-BR', {style: 'currency', currency: 'BRL'});
            const textos = {
               mensal: {{ __('Mensal', 'propostas')|json_encode|raw }},
               unico: {{ __('Pagamento único', 'propostas')|json_encode|raw }},
               sugerido: {{ __('Sugerido pelo modelo: {pct}%', 'propostas')|json_encode|raw }},
               vazio: {{ __('Este modelo não tem itens com valor.', 'propostas')|json_encode|raw }},
               erro: {{ __('Não foi possível carregar os itens do modelo.', 'propostas')|json_encode|raw }}
            };

            function percentual() {
               const v = parseFloat(pct.value);
               return aplicar.checked && v > 0 ? Math.min(v, 100) : 0;
            }

            // Mostra o valor de cada item já com o desconto, como o cliente vai ver.
            function atualizar() {
               pct.disabled = !aplicar.checked;
               const p = percentual();
               lista.querySelectorAll('tr').forEach(function (tr) {
                  const valor = parseFloat(tr.querySelector('input').value) || 0;
                  const final = Math.round(valor * (1 - p / 100) * 100) / 100;
                  const celula = tr.querySelector('.propostas-final');
                  celula.textContent = moeda.format(final);
                  celula.classList.toggle('text-success', p > 0);
                  celula.classList.toggle('text-muted', p === 0);
               });
            }

            function limpar() {
               lista.replaceChildren();
               aplicar.checked = false;
               pct.value = '';
               dica.textContent = '';
               msg.textContent = '';
               atualizar();
            }

            function linha(item) {
               const tr = document.createElement('tr');

               const nome = document.createElement('td');
               const rotulo = document.createElement('label');
               rotulo.htmlFor = 'propostas-valor-' + item.id;
               rotulo.className = 'mb-0';
               rotulo.textContent = item.nome;
               const tipo = document.createElement('span');
               tipo.className = 'badge ms-2 ' + (item.tipo === 'pontual' ? 'bg-secondary-lt' : 'bg-blue-lt');
               tipo.textContent = item.tipo === 'pontual' ? textos.unico : textos.mensal;
               nome.append(rotulo, tipo);

               const valor = document.createElement('td');
               const grupo = document.createElement('div');
               grupo.className = 'input-group input-group-sm';
               const rs = document.createElement('span');
               rs.className = 'input-group-text';
               rs.textContent = 'R$';
               const campo = document.createElement('input');
               campo.type = 'number';
               campo.step = '0.01';
               campo.min = '0';
               campo.className = 'form-control text-end';
               campo.id = 'propostas-valor-' + item.id;
               campo.name = '_modelo_valores[' + item.id + ']';
               campo.value = Number(item.valor).toFixed(2);
               campo.addEventListener('input', atualizar);
               grupo.append(rs, campo);
               valor.append(grupo);

               const final = document.createElement('td');
               final.className = 'text-end fw-bold propostas-final';

               tr.append(nome, valor, final);
               return tr;
            }

            async function carregar(id) {
               limpar();
               if (!id || id === '0') { caixa.classList.add('d-none'); return; }
               caixa.classList.remove('d-none');
               try {
                  const resposta = await fetch(url + '?id=' + encodeURIComponent(id), {credentials: 'same-origin'});
                  const dados = await resposta.json();
                  if (!dados.ok) { msg.textContent = dados.erro || textos.erro; return; }
                  dados.itens.forEach(function (item) { lista.append(linha(item)); });
                  if (dados.itens.length === 0) { msg.textContent = textos.vazio; }
                  if (dados.desconto_especial > 0) {
                     pct.value = dados.desconto_especial;
                     dica.textContent = textos.sugerido.replace('{pct}', String(dados.desconto_especial).replace('.', ','));
                  }
                  atualizar();
               } catch (e) {
                  msg.textContent = textos.erro;
               }
            }

            aplicar.addEventListener('change', atualizar);
            pct.addEventListener('input', atualizar);

            // O campo do modelo é um select2: a troca chega como evento "change" do jQuery.
            $(document).on('change', 'select[name="plugin_propostas_modelos_id"]', function () {
               carregar(this.value);
            });
         })();
      </script>
   {% elseif modelo %}
      {{ fields.htmlField('', '<a href="' ~ modelo.getLinkURL() ~ '">' ~ modelo.fields['name']|e ~ '</a>', __('Modelo de origem', 'propostas')) }}
   {% endif %}

   {# Empresa cliente: obrigatória (razão social e CNPJ) só para gerar o link. #}
   <div class="col-12 mt-2"><h4 class="mb-0"><i class="ti ti-building"></i> {{ __('Empresa cliente', 'propostas') }}</h4></div>

   {% set campo_cnpj %}
      <div class="input-group">
         <input type="text" class="form-control" name="empresa_cnpj" id="propostas-cnpj" maxlength="18"
                value="{{ item.fields['empresa_cnpj'] }}" placeholder="00.000.000/0000-00" {{ editavel ? '' : 'disabled' }}>
         {% if cnpj_consulta and editavel %}
            <button type="button" class="btn btn-outline-secondary" id="propostas-buscar-cnpj">
               <i class="ti ti-search"></i> {{ __('Buscar CNPJ', 'propostas') }}
            </button>
         {% endif %}
      </div>
      <div class="form-text" id="propostas-cnpj-msg"></div>
   {% endset %}
   {{ fields.htmlField('', campo_cnpj, __('CNPJ', 'propostas')) }}

   {{ fields.textField('empresa_razao_social', item.fields['empresa_razao_social'], __('Razão social', 'propostas'), travado|merge({id: 'propostas-razao'})) }}
   {{ fields.textField('empresa_nome_fantasia', item.fields['empresa_nome_fantasia'], __('Nome fantasia', 'propostas'), travado|merge({id: 'propostas-fantasia'})) }}
   {{ fields.textField('solicitante', item.fields['solicitante'], __('Contato na empresa', 'propostas'), travado) }}

   {% if cnpj_consulta and editavel %}
      <script>
         (function () {
            const botao = document.getElementById('propostas-buscar-cnpj');
            if (!botao) { return; }
            botao.addEventListener('click', async function () {
               const msg = document.getElementById('propostas-cnpj-msg');
               const cnpj = document.getElementById('propostas-cnpj').value;
               msg.className = 'form-text';
               msg.textContent = '{{ __('Consultando…', 'propostas')|e('js') }}';
               botao.disabled = true;
               try {
                  const r = await fetch('{{ cnpj_url }}?' + new URLSearchParams({cnpj: cnpj}), {
                     headers: {'X-Requested-With': 'XMLHttpRequest'}
                  });
                  const d = await r.json();
                  if (!d.ok) {
                     msg.className = 'form-text text-danger';
                     msg.textContent = d.erro;
                     return;
                  }
                  document.getElementById('propostas-cnpj').value = d.cnpj;
                  if (d.razao_social) { document.querySelector('[name=empresa_razao_social]').value = d.razao_social; }
                  if (d.nome_fantasia) { document.querySelector('[name=empresa_nome_fantasia]').value = d.nome_fantasia; }
                  msg.className = d.ativa ? 'form-text text-success' : 'form-text text-warning';
                  msg.textContent = d.ativa
                     ? '{{ __('Dados preenchidos. Confira e salve.', 'propostas')|e('js') }}'
                     : '{{ __('Atenção: situação cadastral', 'propostas')|e('js') }} ' + (d.situacao || '?') + '. {{ __('Confira e salve.', 'propostas')|e('js') }}';
               } catch (e) {
                  msg.className = 'form-text text-danger';
                  msg.textContent = '{{ __('Não foi possível consultar agora. Digite os dados à mão.', 'propostas')|e('js') }}';
               } finally {
                  botao.disabled = false;
               }
            });
         })();
      </script>
   {% endif %}

   <div class="col-12 mt-2"><h4 class="mb-0"><i class="ti ti-file-dollar"></i> {{ __('Proposta', 'propostas') }}</h4></div>

   {% if consultores is null %}
      {{ fields.dropdownField('User', 'users_id_consultor', item.fields['users_id_consultor'], __('Consultor', 'propostas'), travado|merge({
         right: 'all',
         entity: item.fields['entities_id']
      })) }}
   {% else %}
      {# Equipes ligadas: só quem este usuário pode pôr como consultor (em branco = ele mesmo, ao criar). #}
      {{ fields.dropdownArrayField('users_id_consultor', item.fields['users_id_consultor'], consultores, __('Consultor', 'propostas'), travado|merge({
         display_emptychoice: true,
         helper: __('Só aparecem os consultores que você pode escolher, pelas equipes.', 'propostas')
      })) }}
   {% endif %}

   {{ fields.dropdownField('Ticket', 'tickets_id', item.fields['tickets_id'], __('Chamado vinculado', 'propostas'), travado|merge({
      entity: item.fields['entities_id'],
      helper: __('Em branco, o plugin abre um chamado ao gerar o link.', 'propostas')
   })) }}

   {{ fields.dateField('data_emissao', item.fields['data_emissao'], __('Emissão', 'propostas'), travado) }}

   {{ fields.numberField('validade_dias', item.fields['validade_dias'], __('Validade (dias)', 'propostas'), travado|merge({min: 1})) }}

   {# Na criação, vem do modelo. Depois, pode ser ajustada enquanto a proposta é rascunho. #}
   {% if not item.isNewItem() %}
      {{ fields.dropdownArrayField('exibicao', item.fields['exibicao'] ?? 'total', exibicoes, __('Valores na página do cliente', 'propostas'), travado) }}
   {% endif %}

   {% if totais %}
      {{ fields.htmlField('', 'R$ ' ~ totais['recorrente'] ~ ' / ' ~ __('mês', 'propostas'), __('Investimento mensal', 'propostas')) }}
      {{ fields.htmlField('', 'R$ ' ~ totais['pontual'], __('Implantação (pagamento único)', 'propostas')) }}
   {% endif %}

   {% if editavel %}
      {{ fields.textareaField('condicoes', item.fields['condicoes'], __('Condições comerciais', 'propostas'), {
         enable_richtext: true,
         full_width: true
      }) }}
   {% else %}
      {# Travada: mostra o texto formatado em vez do HTML cru num campo desabilitado. #}
      {{ fields.htmlField('', item.fields['condicoes']|safe_html, __('Condições comerciais', 'propostas'), {
         full_width: true
      }) }}
   {% endif %}

   {% if not item.isNewItem() %}
      <div class="col-12 mt-3">
         <div class="card bg-light-lt">
            <div class="card-body">
               <h4 class="card-title mb-2">
                  <i class="ti ti-link"></i> {{ __('Link para o cliente', 'propostas') }}
               </h4>

               {% if link_publico %}
                  <div class="input-group mb-2">
                     <input type="text" class="form-control" id="propostas-link" value="{{ link_publico }}" readonly>
                     <button type="button" class="btn btn-outline-secondary" id="propostas-copiar">
                        <i class="ti ti-copy"></i> {{ __('Copiar', 'propostas') }}
                     </button>
                     <a class="btn btn-outline-secondary" href="{{ link_publico }}" target="_blank" rel="noopener">
                        <i class="ti ti-external-link"></i> {{ __('Abrir', 'propostas') }}
                     </a>
                  </div>
                  <div class="text-muted small mb-2">
                     {% if link_expirado %}
                        <span class="text-danger">{{ __('Link expirado em', 'propostas') }} {{ link_expira|formatted_datetime }}.</span>
                     {% else %}
                        {{ __('Válido até', 'propostas') }} {{ link_expira|formatted_datetime }}.
                     {% endif %}
                     {{ __('Abrir o link estando logado no GLPI não conta como visualização do cliente.', 'propostas') }}
                  </div>
               {% elseif link_oculto %}
                  <p class="text-muted mb-2">
                     {{ __('Link enviado ao cliente. O endereço aparece só para quem pode editar a proposta.', 'propostas') }}
                     {% if link_expirado %}
                        <span class="text-danger">{{ __('Link expirado em', 'propostas') }} {{ link_expira|formatted_datetime }}.</span>
                     {% else %}
                        {{ __('Válido até', 'propostas') }} {{ link_expira|formatted_datetime }}.
                     {% endif %}
                  </p>
               {% elseif editavel %}
                  <p class="text-muted mb-2">
                     {{ __('Ao gerar o link, a proposta é travada para edição e passa para "Enviada".', 'propostas') }}
                  </p>
               {% endif %}

               <div class="d-flex flex-wrap gap-2">
                  {% if pode_gerar %}
                     <button type="submit" name="gerar_link" value="1" class="btn btn-primary">
                        <i class="ti ti-send"></i> {{ __('Gerar link', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_reabrir %}
                     <button type="submit" name="reabrir" value="1" class="btn btn-outline-warning"
                             onclick="return confirm('{{ __('Reabrir cria uma nova versão e invalida o link atual. Continuar?', 'propostas')|e('js') }}');">
                        <i class="ti ti-lock-open"></i> {{ __('Reabrir para edição', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_duplicar %}
                     <button type="submit" name="duplicar" value="1" class="btn btn-outline-secondary">
                        <i class="ti ti-copy"></i> {{ __('Duplicar', 'propostas') }}
                     </button>
                  {% endif %}
                  {% if pode_cancelar %}
                     <button type="submit" name="cancelar" value="1" class="btn btn-outline-danger"
                             onclick="return confirm('{{ __('Cancelar a proposta e invalidar o link?', 'propostas')|e('js') }}');">
                        <i class="ti ti-ban"></i> {{ __('Cancelar proposta', 'propostas') }}
                     </button>
                  {% endif %}
               </div>
            </div>
         </div>
      </div>

      {% if link_publico %}
         <script>
            document.getElementById('propostas-copiar')?.addEventListener('click', function () {
               const campo = document.getElementById('propostas-link');
               campo.select();
               navigator.clipboard?.writeText(campo.value);
               this.innerHTML = '<i class="ti ti-check"></i> {{ __('Copiado', 'propostas')|e('js') }}';
            });
         </script>
      {% endif %}
   {% endif %}
{% endblock %}
