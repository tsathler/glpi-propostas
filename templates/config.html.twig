{% import 'components/form/fields_macros.html.twig' as fields %}
<div class="card">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-file-dollar"></i> {{ __('Propostas', 'propostas') }}</h3>
   </div>
   <form method="post" class="card-body">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <div class="mb-3">
         <label class="form-label" for="url_publica">{{ __('Endereço externo do link público', 'propostas') }}</label>
         <input type="url" class="form-control" id="url_publica" name="url_publica" value="{{ url_publica }}"
                placeholder="https://propostas.exemplo.com.br">
         <div class="form-hint mt-1">
            {{ __('É o endereço que o cliente usa de fora da rede. O Nginx desse endereço deve liberar só /plugins/propostas/p/. Em branco, os links usam o endereço do próprio GLPI.', 'propostas') }}
         </div>
      </div>
      <p class="text-muted small">
         {{ __('Os links gerados agora começam com:', 'propostas') }}
         <code>{{ url_efetiva }}/plugins/propostas/p/…</code>
      </p>

      <hr>
      <h4>{{ __('Busca de CNPJ', 'propostas') }}</h4>
      <div class="mb-3 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="cnpj_consulta_ativa" name="cnpj_consulta_ativa" value="1" {{ cnpj_consulta_ativa ? 'checked' }}>
         <label class="form-check-label" for="cnpj_consulta_ativa">{{ __('Mostrar o botão "Buscar CNPJ" na proposta', 'propostas') }}</label>
      </div>
      <div class="mb-3">
         <label class="form-label" for="cnpj_consulta_url">{{ __('URL da consulta', 'propostas') }}</label>
         <input type="text" class="form-control" id="cnpj_consulta_url" name="cnpj_consulta_url" value="{{ cnpj_consulta_url }}"
                placeholder="{{ cnpj_url_padrao }}">
         <div class="form-hint mt-1">
            {{ __('Use {cnpj} no lugar do número. A consulta sai do servidor do GLPI (com o proxy do GLPI, se houver), envia só o CNPJ e espera no máximo 5 segundos. O padrão é a BrasilAPI; a Minha Receita usa o mesmo formato de resposta. Em branco, volta ao padrão.', 'propostas') }}
         </div>
      </div>

      <hr>
      <h4>{{ __('Chamado automático', 'propostas') }}</h4>
      <p class="text-muted small">
         {{ __('Ao gerar o link de uma proposta sem chamado vinculado, o plugin abre um chamado (requisição) na entidade da proposta, com o consultor como requerente e técnico. Envio, aceite, dúvida, cancelamento e expiração viram acompanhamentos privados nele. O chamado é fechado manualmente.', 'propostas') }}
      </p>
      <div class="row">
         {{ fields.dropdownField('ITILCategory', 'chamado_itilcategories_id', chamado_itilcategories_id, __('Categoria do chamado', 'propostas'), {
            condition: {'is_request': 1},
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
         {{ fields.dropdownField('Group', 'chamado_groups_id', chamado_groups_id, __('Grupo técnico atribuído', 'propostas'), {
            condition: {'is_assign': 1},
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      <div class="form-hint mb-3">
         {{ __('Ambos opcionais. Use categoria e grupo visíveis nas entidades onde as propostas são criadas (recursivos na entidade raiz, por exemplo).', 'propostas') }}
      </div>

      <hr>
      <h4>{{ __('Equipes de consultores', 'propostas') }}</h4>
      <p class="text-muted small">
         {{ __('Cada grupo filho direto do grupo pai é uma equipe. O membro marcado como Responsável é o gestor; os outros membros são os consultores. Com o grupo pai escolhido: quem não está em nenhuma equipe não cria propostas (exceto o nível "Ler todas"), o gestor entra como observador nos chamados das propostas da equipe e recebe as notificações com o destinatário "Gestor da equipe do consultor". Em branco, as regras de equipe ficam desligadas.', 'propostas') }}
      </p>
      <div class="row">
         {{ fields.dropdownField('Group', 'equipes_groups_id', equipes_groups_id, __('Grupo pai das equipes', 'propostas'), {
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      {% if equipes_groups_id > 0 %}
         <p class="small mb-2">
            {{ __('Equipes encontradas:', 'propostas') }}
            {{ equipes is empty ? __('nenhuma (o grupo pai não tem grupos filhos).', 'propostas') : equipes|join(', ') }}
         </p>
      {% endif %}
      {% for aviso in avisos_equipes %}
         <div class="alert alert-warning py-2 mb-2"><i class="ti ti-alert-triangle"></i> {{ aviso }}</div>
      {% endfor %}

      <hr>
      <h4>{{ __('Entidade padrão das propostas', 'propostas') }}</h4>
      <div class="mb-2 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="entidade_padrao_ativa" name="entidade_padrao_ativa" value="1" {{ entidade_padrao_ativa ? 'checked' }}>
         <label class="form-check-label" for="entidade_padrao_ativa">{{ __('Criar as propostas sempre nesta entidade (quando o usuário tem acesso a ela)', 'propostas') }}</label>
      </div>
      <div class="row">
         {{ fields.dropdownField('Entity', 'propostas_entities_id', propostas_entities_id, __('Entidade', 'propostas'), {
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      <div class="form-hint mb-3">
         {{ __('Evita que quem tem várias entidades crie a proposta (e o chamado dela) na entidade errada.', 'propostas') }}
      </div>

      <button type="submit" name="update" value="1" class="btn btn-primary">
         <i class="ti ti-device-floppy"></i> {{ _x('button', 'Save') }}
      </button>
      {% if equipes_groups_id > 0 %}
         <button type="submit" name="sincronizar" value="1" class="btn btn-outline-secondary ms-2"
                 title="{{ __('Acerta o gestor observador em todos os chamados abertos das propostas', 'propostas') }}">
            <i class="ti ti-refresh"></i> {{ __('Sincronizar observadores', 'propostas') }}
         </button>
      {% endif %}
   </form>
</div>
