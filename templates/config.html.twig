{% import 'components/form/fields_macros.html.twig' as fields %}
<div class="card">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-file-dollar"></i> {{ __('Propostas', 'propostas') }}</h3>
   </div>
   <form method="post" class="card-body" enctype="multipart/form-data">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <div class="mb-3">
         <label class="form-label" for="url_publica">{{ __('Endereço externo do link público', 'propostas') }}</label>
         <input type="url" class="form-control" id="url_publica" name="url_publica" value="{{ url_publica }}"
                placeholder="https://propostas.exemplo.com.br">
         <div class="form-hint mt-1">
            {{ __('É o endereço que o cliente usa de fora da rede. O Nginx desse endereço deve liberar só /plugins/propostas/p/. Em branco, os links usam o endereço do próprio GLPI.', 'propostas') }}
         </div>
      </div>
      <p class="text-muted small">
         {{ __('Os links gerados agora começam com:', 'propostas') }}
         <code>{{ url_efetiva }}/plugins/propostas/p/…</code>
      </p>

      <hr>
      <h4>{{ __('Identidade visual da página do cliente', 'propostas') }}</h4>
      <div class="row">
         <div class="col-md-6 mb-3">
            <label class="form-label" for="logo_publico">{{ __('Logotipo', 'propostas') }}</label>
            {% if marca_logo %}
               <div class="mb-2 p-3 rounded d-inline-block" style="background: {{ marca_cor_principal ?: marca_padrao.principal }};">
                  <img src="{{ marca_logo }}" alt="{{ __('Logotipo atual', 'propostas') }}" style="max-height: 48px; max-width: 100%;">
               </div>
               <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" id="remover_logo" name="remover_logo" value="1">
                  <label class="form-check-label" for="remover_logo">{{ __('Remover o logotipo', 'propostas') }}</label>
               </div>
            {% endif %}
            <input type="file" class="form-control" id="logo_publico" name="logo_publico" accept="image/png,image/jpeg,image/webp">
            <div class="form-hint mt-1">
               {{ __('PNG, JPEG ou WebP, até 2 MB. Aparece no topo escuro da página: use a versão clara do logotipo, de preferência PNG com fundo transparente. As margens transparentes são cortadas e a altura é reduzida para no máximo 160 px.', 'propostas') }}
            </div>
         </div>
         <div class="col-md-3 mb-3">
            <label class="form-label" for="marca_cor_principal">{{ __('Cor principal', 'propostas') }}</label>
            <input type="text" class="form-control" id="marca_cor_principal" name="marca_cor_principal" maxlength="7"
                   value="{{ marca_cor_principal }}" placeholder="{{ marca_padrao.principal }}">
            <div class="form-hint mt-1">{{ __('Topo e quadro de decisão. Use uma cor escura.', 'propostas') }}</div>
         </div>
         <div class="col-md-3 mb-3">
            <label class="form-label" for="marca_cor_destaque">{{ __('Cor de destaque', 'propostas') }}</label>
            <input type="text" class="form-control" id="marca_cor_destaque" name="marca_cor_destaque" maxlength="7"
                   value="{{ marca_cor_destaque }}" placeholder="{{ marca_padrao.destaque }}">
            <div class="form-hint mt-1">{{ __('Botão de aceite, etiquetas e detalhe dos títulos.', 'propostas') }}</div>
         </div>
      </div>
      <div class="form-hint mb-3">
         {{ __('Cores no formato #rrggbb. Em branco, a página usa as cores padrão do plugin. Cor clara demais para texto branco é escurecida na página, para os botões e o topo continuarem legíveis.', 'propostas') }}
      </div>
      <div class="mb-3">
         <label class="form-label" for="decoracao">{{ __('Elementos decorativos', 'propostas') }}</label>
         {% if marca_decoracao is not empty %}
            <div class="d-flex flex-wrap gap-2 mb-2">
               {% for vaga, uri in marca_decoracao %}
                  <div class="text-center">
                     <div class="p-2 rounded" style="background: {{ marca_cor_principal ?: marca_padrao.principal }};">
                        <img src="{{ uri }}" alt="{{ __('Elemento decorativo', 'propostas') }} {{ vaga }}" style="width: 72px; height: 72px; object-fit: contain;">
                     </div>
                     <div class="form-check d-inline-block mt-1">
                        <input class="form-check-input" type="checkbox" id="remover_decoracao_{{ vaga }}" name="remover_decoracao[]" value="{{ vaga }}">
                        <label class="form-check-label small" for="remover_decoracao_{{ vaga }}">{{ __('Remover', 'propostas') }}</label>
                     </div>
                  </div>
               {% endfor %}
            </div>
         {% endif %}
         {% if marca_decoracao|length < marca_decoracao_maximo %}
            <input type="file" class="form-control" id="decoracao" name="decoracao[]" multiple accept="image/png,image/webp">
         {% endif %}
         <div class="form-hint mt-1">
            {{ __('Até %d imagens em PNG ou WebP com fundo transparente (formas, traços, grafismos da marca), até 2 MB cada. Aparecem espalhadas, giradas e cortadas nas bordas no topo, no quadro de decisão e, em telas largas, bem claras nas margens; cada proposta usa uma combinação delas. As margens transparentes são cortadas e o lado é reduzido para no máximo 360 px. Sem imagens, a página fica sem decoração.', 'propostas')|format(marca_decoracao_maximo) }}
         </div>
      </div>
      <div class="mb-3">
         <label class="form-label" for="marca_rodape">{{ __('Texto do rodapé', 'propostas') }}</label>
         <input type="text" class="form-control" id="marca_rodape" name="marca_rodape" maxlength="{{ marca_rodape_maximo }}"
                value="{{ marca_rodape }}" placeholder="{{ __('Ex.: Copyright © 2026 Sua organização. Todos os direitos reservados', 'propostas') }}">
         <div class="form-hint mt-1">
            {{ __('Uma linha de texto puro, no rodapé da página do cliente, abaixo das informações da proposta. Em branco, não aparece.', 'propostas') }}
         </div>
      </div>
      <div class="mb-3">
         <label class="form-label" for="aviso_privacidade">{{ __('Aviso de privacidade do aceite', 'propostas') }}</label>
         <textarea class="form-control" id="aviso_privacidade" name="aviso_privacidade" rows="3" maxlength="{{ privacidade_maximo }}"
                   placeholder="{{ privacidade_padrao }}">{{ aviso_privacidade }}</textarea>
         <div class="form-hint mt-1">
            {{ __('Texto puro, no formulário de aceite, logo acima do botão. Diga quais dados ficam guardados e para quê (LGPD). Em branco, aparece o texto de exemplo acima. IP e navegador de acessos e dúvidas são apagados depois de 180 dias.', 'propostas') }}
         </div>
      </div>

      <hr>
      <h4>{{ __('Busca de CNPJ', 'propostas') }}</h4>
      <div class="mb-3 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="cnpj_consulta_ativa" name="cnpj_consulta_ativa" value="1" {{ cnpj_consulta_ativa ? 'checked' }}>
         <label class="form-check-label" for="cnpj_consulta_ativa">{{ __('Mostrar o botão "Buscar CNPJ" na proposta', 'propostas') }}</label>
      </div>
      <div class="mb-3">
         <label class="form-label" for="cnpj_consulta_url">{{ __('URL da consulta', 'propostas') }}</label>
         <input type="text" class="form-control" id="cnpj_consulta_url" name="cnpj_consulta_url" value="{{ cnpj_consulta_url }}"
                placeholder="{{ cnpj_url_padrao }}">
         <div class="form-hint mt-1">
            {{ __('Use {cnpj} no lugar do número. A consulta sai do servidor do GLPI (com o proxy do GLPI, se houver), envia só o CNPJ e espera no máximo 5 segundos. O padrão é a BrasilAPI; a Minha Receita usa o mesmo formato de resposta. Em branco, volta ao padrão.', 'propostas') }}
         </div>
      </div>

      <hr>
      <h4>{{ __('Chamado automático', 'propostas') }}</h4>
      <p class="text-muted small">
         {{ __('Ao gerar o link de uma proposta sem chamado vinculado, o plugin abre um chamado (requisição) na entidade da proposta, com o consultor como requerente e técnico. Envio, aceite, dúvida, cancelamento e expiração viram acompanhamentos privados nele. No aceite e na expiração, o plugin fecha o chamado; na proposta cancelada, ele continua aberto. Se a proposta for reaberta e reenviada com o chamado já fechado, o plugin abre outro.', 'propostas') }}
      </p>
      <div class="row">
         {{ fields.dropdownField('ITILCategory', 'chamado_itilcategories_id', chamado_itilcategories_id, __('Categoria do chamado', 'propostas'), {
            condition: {'is_request': 1},
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
         {{ fields.dropdownField('Group', 'chamado_groups_id', chamado_groups_id, __('Grupo técnico atribuído', 'propostas'), {
            condition: {'is_assign': 1},
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      <div class="form-hint mb-3">
         {{ __('Ambos opcionais. Use categoria e grupo visíveis nas entidades onde as propostas são criadas (recursivos na entidade raiz, por exemplo).', 'propostas') }}
      </div>
      {% if chamado_itilcategories_id <= 0 %}
         <div class="alert alert-warning py-2 mb-3"><i class="ti ti-alert-triangle"></i>
            {{ __('Sem categoria, os chamados abertos pelo plugin ficam sem categoria. Se o GLPI exigir categoria em chamado atribuído, esses chamados só poderão ser editados pela tela depois que alguém escolher uma. Recomendado: escolha uma categoria.', 'propostas') }}
         </div>
      {% endif %}

      <hr>
      <h4>{{ __('Equipes de consultores', 'propostas') }}</h4>
      <p class="text-muted small">
         {{ __('Cada grupo filho direto do grupo pai é uma equipe. O membro marcado como Responsável é o gestor; os outros membros são os consultores. Com o grupo pai escolhido: quem não está em nenhuma equipe não cria propostas (exceto o nível "Ler todas"), o gestor entra como observador nos chamados das propostas da equipe e recebe as notificações com o destinatário "Gestor da equipe do consultor". Em branco, as regras de equipe ficam desligadas.', 'propostas') }}
      </p>
      <div class="row">
         {{ fields.dropdownField('Group', 'equipes_groups_id', equipes_groups_id, __('Grupo pai das equipes', 'propostas'), {
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      {% if equipes_groups_id > 0 %}
         <p class="small mb-2">
            {{ __('Equipes encontradas:', 'propostas') }}
            {{ equipes is empty ? __('nenhuma (o grupo pai não tem grupos filhos).', 'propostas') : equipes|join(', ') }}
         </p>
      {% endif %}
      {% for aviso in avisos_equipes %}
         <div class="alert alert-warning py-2 mb-2"><i class="ti ti-alert-triangle"></i> {{ aviso }}</div>
      {% endfor %}

      <hr>
      <h4>{{ __('Formulário da proposta', 'propostas') }}</h4>
      <div class="mb-2 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="campo_nome_ativo" name="campo_nome_ativo" value="1" {{ campo_nome_ativo ? 'checked' }}>
         <label class="form-check-label" for="campo_nome_ativo">{{ __('Pedir o nome da proposta', 'propostas') }}</label>
      </div>
      <div class="form-hint mb-3">
         {{ __('Desligado, o campo Nome sai do formulário e o nome é gerado sozinho: "{modelo} – {razão social}", atualizado quando a razão social muda. Ligado, o nome em branco também é gerado assim.', 'propostas') }}
      </div>
      <div class="mb-2 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="campo_condicoes_ativo" name="campo_condicoes_ativo" value="1" {{ campo_condicoes_ativo ? 'checked' }}>
         <label class="form-check-label" for="campo_condicoes_ativo">{{ __('Permitir editar as condições comerciais na proposta', 'propostas') }}</label>
      </div>
      <div class="form-hint mb-3">
         {{ __('Desligado, o campo Condições comerciais sai do formulário da proposta: ela leva só o texto do modelo, mostrado para leitura. O texto continua editável no modelo, por quem gerencia modelos.', 'propostas') }}
      </div>

      <hr>
      <h4>{{ __('Entidade padrão das propostas', 'propostas') }}</h4>
      <div class="mb-2 form-check form-switch">
         <input class="form-check-input" type="checkbox" id="entidade_padrao_ativa" name="entidade_padrao_ativa" value="1" {{ entidade_padrao_ativa ? 'checked' }}>
         <label class="form-check-label" for="entidade_padrao_ativa">{{ __('Criar as propostas sempre nesta entidade (quando o usuário tem acesso a ela)', 'propostas') }}</label>
      </div>
      <div class="row">
         {{ fields.dropdownField('Entity', 'propostas_entities_id', propostas_entities_id, __('Entidade', 'propostas'), {
            entity: 0,
            entity_sons: true,
            is_horizontal: false,
            field_class: 'col-md-6 mb-3'
         }) }}
      </div>
      <div class="form-hint mb-3">
         {{ __('Evita que quem tem várias entidades crie a proposta (e o chamado dela) na entidade errada.', 'propostas') }}
      </div>

      <button type="submit" name="update" value="1" class="btn btn-primary">
         <i class="ti ti-device-floppy"></i> {{ _x('button', 'Save') }}
      </button>
      {% if equipes_groups_id > 0 %}
         <button type="submit" name="sincronizar" value="1" class="btn btn-outline-secondary ms-2"
                 title="{{ __('Acerta o gestor observador em todos os chamados abertos das propostas', 'propostas') }}">
            <i class="ti ti-refresh"></i> {{ __('Sincronizar observadores', 'propostas') }}
         </button>
      {% endif %}
   </form>
</div>
