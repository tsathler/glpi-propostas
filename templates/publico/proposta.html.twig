{% extends '@propostas/publico/_base.html.twig' %}
{% import '@propostas/publico/_marca.html.twig' as ui %}

{% block titulo %}Proposta {{ p.numero }} — {{ p.titulo }}{% endblock %}

{% block conteudo %}
{% set por_unidade = p.exibicao == 'unidade' %}
{% set tem_itens = p.recorrentes or p.pontuais %}
{# Elementos decorativos: cada vaga recebe uma das imagens configuradas, em rodízio a partir do número da proposta. #}
{% set decos = marca.decoracao|default([])|length %}
{% set semente = p.numero|default(0) * 1 %}
{% if decos %}
   <div class="margens" aria-hidden="true">{{ ui.deco('m1', 5, decos, semente) }}{{ ui.deco('m2', 6, decos, semente) }}</div>
{% endif %}
<header class="topo">
   {% if decos %}{% for v in ['t1', 't2', 't3', 't4'] %}{{ ui.deco(v, loop.index0, decos, semente) }}{% endfor %}{% endif %}
   <div class="wrap">
      <div class="topo-marca">
         {% if marca.logo %}<img src="{{ marca.logo }}" alt="">{% endif %}
         {# A revisão só aparece a partir da segunda versão: na primeira não há outra para confundir. #}
         <div class="rotulo">Proposta comercial · nº {{ p.numero }}{% if p.versao > 1 %} · revisão {{ p.versao }}{% endif %}</div>
      </div>
      {% if p.empresa.razao_social %}
         <p class="para">Proposta para</p>
         <h1{{ p.empresa.razao_social|length > 48 ? ' class="longo"' }}>{{ p.empresa.razao_social }}</h1>
         {% if p.subtitulo %}<div class="sub">{{ p.subtitulo }}</div>{% endif %}
         {% if p.empresa.nome_fantasia or p.empresa.cnpj %}
            <div class="empresa">
               {% if p.empresa.nome_fantasia %}{{ p.empresa.nome_fantasia }}{% endif %}
               {% if p.empresa.nome_fantasia and p.empresa.cnpj %} · {% endif %}
               {% if p.empresa.cnpj %}CNPJ {{ p.empresa.cnpj }}{% endif %}
            </div>
         {% endif %}
      {% else %}
         <h1>{{ p.titulo }}</h1>
      {% endif %}
   </div>
</header>

<main class="wrap">
   {# Dados fixos, uma vez só: emissão, validade, contato e consultor. #}
   <div class="ficha">
      <div><span class="k">Emissão</span><span class="v">{{ p.emissao }}</span></div>
      <div><span class="k">Válida até</span><span class="v">{{ p.valida_ate }} <small>({{ p.validade_dias }} {{ p.validade_dias == 1 ? 'dia' : 'dias' }})</small></span></div>
      {% if p.solicitante %}
         <div><span class="k">Contato</span><span class="v">{{ p.solicitante }}</span></div>
      {% endif %}
      {% if p.consultor %}
         <div><span class="k">Consultor</span><span class="v">{{ p.consultor }}</span></div>
      {% endif %}
      <div class="ficha-acao">
         <button type="button" class="botao leve" onclick="window.print()">Imprimir / PDF</button>
      </div>
   </div>

   {% if sucesso == 'duvida' %}
      <div class="faixa ok" role="status">Sua dúvida foi enviada. O consultor foi avisado e vai responder.</div>
   {% endif %}
   {% if p.aceite %}
      <div class="faixa ok" role="status">
         <strong>Proposta aceita</strong> em {{ p.aceite.data }} por {{ p.aceite.nome }}{% if p.aceite.cargo %} ({{ p.aceite.cargo }}){% endif %}.
         Código de verificação: <code>{{ p.aceite.codigo }}</code>
      </div>
   {% endif %}

   {# Blocos marcados "depois dos valores" (agradecimento, assinatura...) vão para o fim da página. #}
   {% for b in p.blocos|filter(b => not b.depois) %}
      <section class="sec bloco">
         <h2>{{ b.titulo }}</h2>
         {% if b.conteudo %}<div class="card texto">{{ b.conteudo|safe_html }}</div>{% endif %}
      </section>
   {% endfor %}

   {% if tem_itens %}
      <section class="sec" id="investimento">
         <h2>Investimento</h2>

         {% if por_unidade %}
            {# Por unidade, os preços são de coisas diferentes (por pessoa, por mês...): não há total a somar. #}
            {% set itens = p.recorrentes|merge(p.pontuais) %}
            <div class="precos{{ itens|length == 1 ? ' um' }}">
               {% for i in itens %}
                  {% set mensal = loop.index0 < p.recorrentes|length %}
                  <article class="preco{{ mensal ? '' : ' unico' }}">
                     <div class="preco-topo">
                        <span class="tipo">{{ mensal ? 'Valor mensal' : 'Pagamento único' }}</span>
                        {% if i.desconto %}<span class="selo">{{ i.desconto }} de desconto</span>{% endif %}
                     </div>
                     <h3 class="nome">{{ i.nome }}</h3>
                     <div class="precificacao">
                        {% if i.desconto %}<div class="de">de <s>{{ i.unitario }}</s> por</div>{% endif %}
                        <div class="valor">{{ i.final }}{% if mensal %} <small>/mês</small>{% endif %}</div>
                     </div>
                  </article>
               {% endfor %}
            </div>
         {% else %}
            <div class="totais">
               {% if p.recorrentes %}
                  <div class="tile forte">
                     <div class="k">Investimento mensal</div>
                     <div class="valor">{{ p.total_mensal }} <small>/mês</small></div>
                     <div class="nota">Recorrente</div>
                  </div>
               {% endif %}
               {% if p.pontuais %}
                  <div class="tile{{ p.recorrentes ? '' : ' forte' }}">
                     <div class="k">Implantação</div>
                     <div class="valor">{{ p.total_unico }}</div>
                     <div class="nota">Pagamento único</div>
                  </div>
               {% endif %}
            </div>

            {% if p.recorrentes %}
               <h3>O que está incluído por mês</h3>
               <div class="card">
                  <div class="barra" aria-hidden="true">
                     {% for i in p.recorrentes %}
                        <span style="width: {{ i.percentual }}%; background: {{ i.cor }};"></span>
                     {% endfor %}
                  </div>
                  {% for i in p.recorrentes %}
                     <div class="linha">
                        <div class="nome">
                           <span class="ponto" style="background: {{ i.cor }};"></span>
                           <div>
                              {{ i.nome }}
                              <span class="detalhe">
                                 {{ i.quantidade }} × {{ i.unitario }}
                                 {% if i.desconto %}<span class="desconto">−{{ i.desconto }}</span>{% endif %}
                              </span>
                           </div>
                        </div>
                        <div class="sub">{{ i.subtotal }} <small>/mês</small></div>
                     </div>
                  {% endfor %}
                  <div class="total"><span>Total mensal</span><span>{{ p.total_mensal }}</span></div>
               </div>
            {% endif %}

            {% if p.pontuais %}
               <h3>Implantação (pagamento único)</h3>
               <div class="card">
                  {% for i in p.pontuais %}
                     <div class="linha">
                        <div class="nome">
                           <span class="ponto" style="background: {{ i.cor }};"></span>
                           <div>
                              {{ i.nome }}
                              <span class="detalhe">
                                 {{ i.quantidade }} × {{ i.unitario }}
                                 {% if i.desconto %}<span class="desconto">−{{ i.desconto }}</span>{% endif %}
                              </span>
                           </div>
                        </div>
                        <div class="sub">{{ i.subtotal }}</div>
                     </div>
                  {% endfor %}
                  <div class="total"><span>Total da implantação</span><span>{{ p.total_unico }}</span></div>
               </div>
            {% endif %}
         {% endif %}
      </section>
   {% endif %}

   {# Emissão e consultor já estão na ficha do topo: aqui ficam o prazo e o texto das condições. #}
   <section class="sec">
      <h2>Condições comerciais</h2>
      <div class="card">
         <p class="validade">
            <span>Proposta válida por <strong>{{ p.validade_dias }} {{ p.validade_dias == 1 ? 'dia' : 'dias' }}</strong>, até <strong>{{ p.valida_ate }}</strong>.</span>
         </p>
         {% if p.condicoes %}
            <div class="condicoes texto">{{ p.condicoes|safe_html }}</div>
         {% endif %}
      </div>
   </section>

   {% for b in p.blocos|filter(b => b.depois) %}
      <section class="bloco fecho">
         <h2>{{ b.titulo }}</h2>
         {% if b.conteudo %}<div class="card texto">{{ b.conteudo|safe_html }}</div>{% endif %}
      </section>
   {% endfor %}

   {% if p.pode_responder %}
      <section class="decisao" id="responder">
         {% if decos %}{{ ui.deco('d1', 4, decos, semente) }}{% endif %}
         <h2>Vamos avançar?</h2>
         <p>Aceite a proposta para o seu consultor dar andamento, ou envie suas dúvidas antes.</p>

         {% if erros %}
            <div class="faixa erro" role="alert">
               {% for erro in erros %}<div>{{ erro }}</div>{% endfor %}
            </div>
         {% endif %}

         <details class="painel" id="painel-aceite" {{ form_aberto == 'aceite' ? 'open' }}>
            <summary class="botao primario">Aceitar proposta</summary>
            <form method="post" action="{{ acao_aceite }}" class="formulario" accept-charset="UTF-8">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <p class="nota">
                  O aceite fica registrado com data, hora e um código de verificação dos valores desta proposta
                  (versão {{ p.versao }}).
               </p>
               <label>Nome completo
                  <input type="text" name="nome" required maxlength="255" autocomplete="name"
                         placeholder="Como consta no seu documento" value="{{ valores.nome|default('') }}">
               </label>
               <div class="duas">
                  <label>CPF
                     <input type="text" name="cpf" id="aceite-cpf" required maxlength="14" inputmode="numeric" autocomplete="off"
                            placeholder="000.000.000-00" aria-describedby="aceite-cpf-aviso">
                     <span class="aviso-campo" id="aceite-cpf-aviso" aria-live="polite"></span>
                  </label>
                  <label>Cargo na empresa
                     <input type="text" name="cargo" required maxlength="255" autocomplete="organization-title"
                            value="{{ valores.cargo|default('') }}">
                  </label>
               </div>
               <label class="check">
                  <input type="checkbox" name="declaracao" value="1" required>
                  <span>Declaro ter poderes para aceitar esta proposta em nome de
                     <strong>{{ p.empresa.razao_social }}</strong>, CNPJ {{ p.empresa.cnpj }}, e que li e concordo
                     com as condições desta proposta.</span>
               </label>
               <button type="submit" class="botao primario">Confirmar aceite</button>
            </form>
         </details>

         <details class="painel" {{ form_aberto == 'duvida' ? 'open' }}>
            <summary class="botao">Tenho dúvidas</summary>
            <form method="post" action="{{ acao_duvida }}" class="formulario" accept-charset="UTF-8">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <label>Seu nome
                  <input type="text" name="nome" required maxlength="255" autocomplete="name"
                         value="{{ valores.nome|default('') }}">
               </label>
               <label>Sua dúvida
                  <textarea name="mensagem" required maxlength="3000" rows="5">{{ valores.mensagem|default('') }}</textarea>
               </label>
               <button type="submit" class="botao primario">Enviar dúvida</button>
            </form>
         </details>
      </section>

      {# Atalho para a decisão enquanto ela está fora da tela. Sem JavaScript, continua um link comum. #}
      <a class="cta" id="cta" href="#responder">Aceitar proposta</a>
      <script>
         /* Atalho fixo: some quando o quadro de decisão aparece na tela (ou já ficou para cima) e abre o
            formulário de aceite ao clicar. */
         (function () {
            const cta = document.getElementById('cta');
            const quadro = document.getElementById('responder');
            const painel = document.getElementById('painel-aceite');
            if (!cta || !quadro) { return; }
            if ('IntersectionObserver' in window) {
               new IntersectionObserver(function (entradas) {
                  cta.classList.toggle('oculto', entradas[0].isIntersecting || entradas[0].boundingClientRect.top < 0);
               }, {threshold: 0.05}).observe(quadro);
            }
            cta.addEventListener('click', function () {
               if (painel) { painel.open = true; }
            });
         })();
      </script>
      <script>
         /* CPF: pontos e traço entram sozinhos; com os 11 dígitos, confere os verificadores antes de enviar.
            O servidor confere de novo (Cpf::validar) e aceita com ou sem pontuação. */
         (function () {
            const campo = document.getElementById('aceite-cpf');
            const aviso = document.getElementById('aceite-cpf-aviso');
            if (!campo) { return; }

            function digitos(valor) {
               return valor.replace(/\D/g, '').slice(0, 11);
            }

            function formatar(d) {
               let s = d.slice(0, 3);
               if (d.length > 3) { s += '.' + d.slice(3, 6); }
               if (d.length > 6) { s += '.' + d.slice(6, 9); }
               if (d.length > 9) { s += '-' + d.slice(9, 11); }
               return s;
            }

            function valido(d) {
               if (d.length !== 11 || /^(\d)\1{10}$/.test(d)) { return false; }
               for (let t = 9; t < 11; t++) {
                  let soma = 0;
                  for (let i = 0; i < t; i++) { soma += Number(d[i]) * (t + 1 - i); }
                  if (Number(d[t]) !== ((10 * soma) % 11) % 10) { return false; }
               }
               return true;
            }

            function conferir() {
               const d = digitos(campo.value);
               campo.value = formatar(d);
               const erro = d.length === 11 && !valido(d) ? 'CPF inválido — confira os números.' : '';
               campo.setCustomValidity(erro);
               campo.classList.toggle('invalido', erro !== '');
               aviso.textContent = erro;
            }

            campo.addEventListener('input', conferir);
            campo.addEventListener('blur', conferir);
         })();
      </script>
   {% endif %}
</main>

{# Número e versão já estão no topo; o rodapé fica com o aviso de contato (quando não dá mais para
   responder por aqui) e o texto configurado. #}
{{ ui.rodape(marca, not p.pode_responder and not p.aceite) }}
{% endblock %}
