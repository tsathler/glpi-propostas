         .deco { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
         section { margin-top: 28px; }
         h2 { break-after: avoid; }
         .preco, .totais .tile, .linha, .validade { break-inside: avoid; }
      }
   </style>
</head>
