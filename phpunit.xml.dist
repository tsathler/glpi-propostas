<?xml version="1.0" encoding="UTF-8"?>
<!--
  Testes das classes que não dependem do GLPI (Calculo, Cpf).
  Rodar: composer install && vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="propostas">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>src/Calculo.php</file>
            <file>src/Cpf.php</file>
        </include>
    </source>
</phpunit>
